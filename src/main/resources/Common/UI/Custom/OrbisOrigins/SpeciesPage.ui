// Orbis Origins species selection ("Avatar Studio"). Editor on the left, the live in-world preview
// entity in the open middle, a character sheet on the right. SpeciesSelectionPage fills it.
// Live 3D previews (ItemPreviewComponent) are capped by the client at 32 at once: the species rail
// and the style grid are paged so that no more than 21 exist at a time.
$C = "../Common.ui";
$T = "Theme.ui";

@PagerButton = Button {
  @Icon = "";
  Anchor: (Width: 32, Height: 28);
  Style: (Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 8)), Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 8)), Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 8)), Disabled: (Background: (TexturePath: "../Common/Buttons/Disabled.png", Border: 8)), Sounds: $C.@ButtonSounds);
  Group { Anchor: (Width: 14, Height: 14); Background: @Icon; HitTestVisible: false; }
};

@IconButton = Button {
  @Icon = "";
  Anchor: (Width: 44, Height: 44, Right: 6);
  Style: (Default: (Background: (TexturePath: "../Common/Buttons/Secondary.png", Border: 12)), Hovered: (Background: (TexturePath: "../Common/Buttons/Secondary_Hovered.png", Border: 12)), Pressed: (Background: (TexturePath: "../Common/Buttons/Secondary_Pressed.png", Border: 12)), Sounds: $C.@ButtonSounds);
  Group { Anchor: (Width: 20, Height: 20); Background: @Icon; HitTestVisible: false; }
};

@StatRow = Group {
  @Icon = "";
  @Name = "";
  @BarColor = #c94b4b;
  LayoutMode: Left;
  Anchor: (Height: 30, Bottom: 6);
  AssetImage { Anchor: (Width: 26, Height: 26, Right: 10); AssetPath: @Icon; }
  Label { Anchor: (Width: 92); Text: @Name; Style: (FontSize: 15, RenderBold: true, TextColor: #b9c6d3, VerticalAlignment: Center); }
  Group {
    Anchor: (Width: 202, Height: 10);
    Background: #05090e(0.9);
    OutlineSize: 1;
    OutlineColor: #2b3a4d;
    // The fill; Java sends its whole Anchor. The tick marks the unmodified value.
    Group #StatFill { Anchor: (Left: 1, Top: 1, Bottom: 1, Width: 100); Background: @BarColor; }
    Group { Anchor: (Left: 100, Top: -3, Bottom: -3, Width: 2); Background: #d1dae6(0.6); }
  }
  Label #StatValue { FlexWeight: 1; Text: ""; Style: (FontSize: 15, RenderBold: true, TextColor: #96a9be, HorizontalAlignment: End, VerticalAlignment: Center); }
};

Group #OrbisRoot {
  Anchor: (Full: 0);

  // ---------- Left: editor ----------
  $C.@DecoratedContainer #Editor {
    Anchor: (Left: 50, Top: 80, Width: 770, Height: 820);

    #Title {
      $C.@Title { @Text = %server.customUI.orbisOrigins.title; }
    }

    #Content {
      LayoutMode: Left;

      // Species rail (scrolls; each tile is a live preview)
      Group #SpeciesRail {
        Anchor: (Width: 92);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Right: 8);
      }

      Group { Anchor: (Width: 2, Right: 8); Background: #2b3542; }

      // Category rail
      Group #CategoryRail {
        Anchor: (Width: 64);
        LayoutMode: TopScrolling;
        ScrollbarStyle: (Spacing: 0, Size: 0);
      }

      // Options
      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Left: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 30);
          Label #CrumbSpecies { Text: ""; Style: (FontName: "Secondary", FontSize: 17, RenderBold: true, RenderUppercase: true, TextColor: #d1dae6, VerticalAlignment: Center); }
          Label { Text: "  /  "; Style: (FontSize: 16, TextColor: #5f6f82, VerticalAlignment: Center); }
          Label #CrumbCategory { Text: ""; Style: (FontName: "Secondary", FontSize: 17, RenderBold: true, RenderUppercase: true, TextColor: #E8A93B, VerticalAlignment: Center); }
          Group { FlexWeight: 1; }
          Label #CrumbCount { Text: ""; Style: (FontSize: 12, RenderBold: true, RenderUppercase: true, TextColor: #5f6f82, VerticalAlignment: Center); }
        }

        $C.@TextField #Search {
          Anchor: (Height: 34, Top: 8, Bottom: 12);
          PlaceholderText: %server.customUI.orbisOrigins.search;
        }

        Group #StyleGrid {
          LayoutMode: LeftWrap;
          Anchor: (Height: 372);
        }

        Group #StylePager {
          LayoutMode: Left;
          Anchor: (Height: 28, Bottom: 6);
          @PagerButton #StylePrev { @Icon = "../Arrow-Left.png"; }
          Label #StylePage { FlexWeight: 1; Text: ""; Style: (FontSize: 13, RenderBold: true, TextColor: #5f6f82, HorizontalAlignment: Center, VerticalAlignment: Center); }
          @PagerButton #StyleNext { @Icon = "../Arrow-Right.png"; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 26, Top: 2);
          Label #StyleName { Text: ""; Style: (FontSize: 18, RenderBold: true, TextColor: #f1e3c4, VerticalAlignment: Center); }
          Group { FlexWeight: 1; }
          Label #ColourName { Text: ""; Style: (FontSize: 14, RenderBold: true, TextColor: #8a7650, VerticalAlignment: Center); }
        }

        Label #EmptyNote {
          Anchor: (Top: 20);
          Text: %server.customUI.orbisOrigins.noCosmetics;
          Style: (FontSize: 15, TextColor: #5f6f82, Wrap: true);
          Visible: false;
        }

        Group #ColourSection {
          LayoutMode: Top;
          Visible: false;
          $T.@Section #ColourHeading { @Text = %server.customUI.orbisOrigins.colour; }
          Group #ColourGrid { LayoutMode: LeftWrap; }
        }
      }
    }
  }

  // ---------- Under the in-world preview ----------
  Group {
    LayoutMode: Left;
    Anchor: (Left: 950, Top: 790, Width: 300, Height: 44);
    @IconButton #RotateLeft { @Icon = "../Arrow-Left.png"; TooltipText: %server.customUI.orbisOrigins.rotate; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    @IconButton #RotateRight { @Icon = "../Arrow-Right.png"; TooltipText: %server.customUI.orbisOrigins.rotate; TextTooltipStyle: $C.@DefaultTextTooltipStyle; }
    Group { Anchor: (Width: 16); }
    $C.@SecondaryTextButton #Randomize { @Text = %server.customUI.orbisOrigins.randomize; @Anchor = (Width: 172); }
  }

  // ---------- Right: character sheet ----------
  $C.@Container #Sheet {
    Anchor: (Right: 50, Top: 80, Width: 470, Height: 730);

    #Title {
      $C.@Title { @Text = %server.customUI.orbisOrigins.sheet; }
    }

    #Content {
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;

      Group {
        LayoutMode: Left;
        Anchor: (Height: 84);
        Group {
          Anchor: (Width: 80, Height: 80, Right: 14);
          Background: #0d1520(0.85);
          OutlineSize: 2;
          OutlineColor: #E8A93B;
          ItemPreviewComponent #SheetPreview { Anchor: (Full: 2); ItemScale: 1; }
        }
        Group {
          FlexWeight: 1;
          LayoutMode: Middle;
          Label #SheetName { Text: ""; Style: (FontName: "Secondary", FontSize: 28, RenderBold: true, RenderUppercase: true, TextColor: #f1e3c4); }
          Label #SheetSub { Text: ""; Style: (FontSize: 14, RenderBold: true, TextColor: #b08d4a); }
        }
      }

      Label #SheetDesc {
        Anchor: (Top: 10);
        Text: "";
        Style: (FontSize: 15, TextColor: #b9c6d3, Wrap: true);
      }

      $T.@Section { @Text = %server.customUI.orbisOrigins.attributes; }
      @StatRow #HealthRow { @Icon = "UI/StatusEffects/AddHealth/Large.png"; @Name = %server.customUI.orbisOrigins.health; @BarColor = #c94b4b; }
      @StatRow #StaminaRow { @Icon = "UI/StatusEffects/Stamina.png"; @Name = %server.customUI.orbisOrigins.stamina; @BarColor = #d9a63a; }
      @StatRow #ManaRow { @Icon = "Icons/ItemCategories/Items-Ingredients.png"; @Name = %server.customUI.orbisOrigins.mana; @BarColor = #4f7fd9; }

      $T.@Section { @Text = %server.customUI.orbisOrigins.resistances; }
      Group #ResistList { LayoutMode: LeftWrap; }
      Label #ResistNone { Text: %server.customUI.orbisOrigins.noneListed; Style: (FontSize: 14, TextColor: #5f6f82); Visible: false; }

      $T.@Section { @Text = %server.customUI.orbisOrigins.abilities; }
      Group #AbilityList { LayoutMode: Top; }
      Label #AbilityNone { Text: %server.customUI.orbisOrigins.noneListed; Style: (FontSize: 14, TextColor: #5f6f82); Visible: false; }

      $T.@Section { @Text = %server.customUI.orbisOrigins.starterKit; }
      Group #KitList { LayoutMode: LeftWrap; }
      Label #KitNone { Text: %server.customUI.orbisOrigins.noneListed; Style: (FontSize: 14, TextColor: #5f6f82); Visible: false; }
    }
  }

  // ---------- Actions ----------
  Group {
    LayoutMode: Right;
    Anchor: (Right: 50, Top: 826, Width: 470, Height: 44);
    $C.@TextButton #ConfirmButton { @Text = %server.customUI.orbisOrigins.confirm; @Anchor = (Width: 280); }
    Group { Anchor: (Width: 10); }
    $C.@CancelTextButton #CancelButton { @Text = %server.customUI.orbisOrigins.cancel; @Anchor = (Width: 180); }
  }
}
