// A damage resistance or weakness. Java sets #ChipIcon.AssetPath (a vanilla icon), #ChipText.Text
// and #ChipText.Style.TextColor (green for a resistance, red for a weakness).
Group {
  LayoutMode: Left;
  Anchor: (Height: 32, Right: 8, Bottom: 8);
  Padding: (Horizontal: 8);
  Background: #0d1520(0.85);
  OutlineSize: 1;
  OutlineColor: #2b3a4d;

  AssetImage #ChipIcon {
    Anchor: (Width: 20, Height: 20, Right: 6);
    AssetPath: "Icons/ItemCategories/Items-Shields.png";
  }

  Label #ChipText {
    Text: "";
    Style: (FontSize: 14, RenderBold: true, TextColor: #7fd36b, VerticalAlignment: Center);
  }
}
