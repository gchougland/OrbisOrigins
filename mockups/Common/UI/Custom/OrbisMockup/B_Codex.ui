// Mockup B, step 1: "Origins Codex". A full-screen book of species with pre-rendered hero
// art and a full RPG character sheet. Step 2 (B_Appearance.ui) opens the live preview.
$C = "../Common.ui";
$K = "Kit.ui";

@Card = Button {
  @Img = "";
  @Name = "";
  @Role = "";
  @H = 65;
  @S = 65;
  @M = 65;
  Anchor: (Width: 160, Height: 178, Right: 12, Bottom: 12);
  LayoutMode: Top;
  Padding: (Full: 8);
  Style: (Default: (Background: #18222f(0.92)), Hovered: (Background: #24364a(0.95)));
  OutlineSize: 1;
  OutlineColor: #2b3a4d;
  Group { Anchor: (Width: 92, Height: 92); Background: @Img; }
  Label { Text: @Name; Anchor: (Top: 4); Style: (FontSize: 15, RenderBold: true, TextColor: #d1dae6, HorizontalAlignment: Center); }
  Label { Text: @Role; Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #8a7650, HorizontalAlignment: Center); }
  Group {
    LayoutMode: Left;
    Anchor: (Height: 5, Top: 7, Horizontal: 6);
    Group { Anchor: (Width: 44, Right: 3); Background: #05090e; Group { Anchor: (Left: 0, Width: @H * 44 / 130); Background: #c94b4b; } }
    Group { Anchor: (Width: 44, Right: 3); Background: #05090e; Group { Anchor: (Left: 0, Width: @S * 44 / 130); Background: #d9a63a; } }
    Group { Anchor: (Width: 44); Background: #05090e; Group { Anchor: (Left: 0, Width: @M * 44 / 130); Background: #4f7fd9; } }
  }
};

@CardOn = Button {
  @Img = "";
  @Name = "";
  @Role = "";
  @H = 65;
  @S = 65;
  @M = 65;
  Anchor: (Width: 160, Height: 178, Right: 12, Bottom: 12);
  LayoutMode: Top;
  Padding: (Full: 8);
  Style: (Default: (Background: #2a2210(0.92)));
  OutlineSize: 2;
  OutlineColor: #E8A93B;
  Group { Anchor: (Width: 92, Height: 92); Background: @Img; }
  Label { Text: @Name; Anchor: (Top: 4); Style: (FontSize: 15, RenderBold: true, TextColor: #f1c46b, HorizontalAlignment: Center); }
  Label { Text: @Role; Style: (FontSize: 11, RenderBold: true, RenderUppercase: true, TextColor: #b08d4a, HorizontalAlignment: Center); }
  Group {
    LayoutMode: Left;
    Anchor: (Height: 5, Top: 7, Horizontal: 6);
    Group { Anchor: (Width: 44, Right: 3); Background: #05090e; Group { Anchor: (Left: 0, Width: @H * 44 / 130); Background: #c94b4b; } }
    Group { Anchor: (Width: 44, Right: 3); Background: #05090e; Group { Anchor: (Left: 0, Width: @S * 44 / 130); Background: #d9a63a; } }
    Group { Anchor: (Width: 44); Background: #05090e; Group { Anchor: (Left: 0, Width: @M * 44 / 130); Background: #4f7fd9; } }
  }
};

@Fact = Group {
  @K = "";
  @V = "";
  LayoutMode: Left;
  Anchor: (Height: 24);
  Label { Anchor: (Width: 130); Text: @K; Style: (FontSize: 14, TextColor: #5f6f82, RenderBold: true); }
  Label { Text: @V; Style: (FontSize: 14, TextColor: #b9c6d3); }
};

@Chip = TextButton {
  @Text = "";
  Anchor: (Height: 30, Right: 8);
  Padding: (Horizontal: 14);
  Text: @Text;
  Style: (Default: (Background: #18222f(0.92), LabelStyle: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #96a9be, VerticalAlignment: Center)));
};

@ChipOn = TextButton {
  @Text = "";
  Anchor: (Height: 30, Right: 8);
  Padding: (Horizontal: 14);
  Text: @Text;
  Style: (Default: (Background: #E8A93B, LabelStyle: (FontSize: 13, RenderBold: true, RenderUppercase: true, TextColor: #1a1206, VerticalAlignment: Center)));
};

@Step = Group {
  @Num = "1";
  @Text = "";
  @On = false;
  LayoutMode: Left;
  Anchor: (Height: 36, Horizontal: 10);
  Group {
    Anchor: (Width: 30, Height: 30, Right: 10);
    Background: #E8A93B;
    Label { Text: @Num; Style: (FontSize: 16, RenderBold: true, TextColor: #1a1206, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
  Label { Text: @Text; Style: (FontName: "Secondary", FontSize: 18, RenderBold: true, RenderUppercase: true, TextColor: #f1e3c4, VerticalAlignment: Center); }
};

@StepOff = Group {
  @Num = "2";
  @Text = "";
  LayoutMode: Left;
  Anchor: (Height: 36, Horizontal: 10);
  Group {
    Anchor: (Width: 30, Height: 30, Right: 10);
    Background: #18222f;
    OutlineSize: 1;
    OutlineColor: #5f6f82;
    Label { Text: @Num; Style: (FontSize: 16, RenderBold: true, TextColor: #5f6f82, HorizontalAlignment: Center, VerticalAlignment: Center); }
  }
  Label { Text: @Text; Style: (FontName: "Secondary", FontSize: 18, RenderBold: true, RenderUppercase: true, TextColor: #5f6f82, VerticalAlignment: Center); }
};

Group #Root {
  Anchor: (Full: 0);
  Background: #000000(0.55);

  // Stepper
  Group {
    LayoutMode: Center;
    Anchor: (Top: 30, Height: 40);
    @Step { @Text = "Origin"; }
    Group { Anchor: (Width: 1); }
    Group { Anchor: (Width: 80, Height: 2); Background: #5f6f82; }
    @StepOff { @Text = "Appearance"; }
  }

  $C.@DecoratedContainer #Book {
    Anchor: (Left: 70, Right: 70, Top: 100, Bottom: 120);

    #Title { $C.@Title { @Text = "Origins Codex"; } }

    #Content {
      LayoutMode: Left;

      // ---- Gallery ----
      Group {
        Anchor: (Width: 700);
        LayoutMode: Top;
        Group {
          LayoutMode: Left;
          Anchor: (Height: 30, Bottom: 14);
          @ChipOn { @Text = "All"; }
          @Chip { @Text = "Folk"; }
          @Chip { @Text = "Beasts"; }
          @Chip { @Text = "Constructs"; }
          @Chip { @Text = "Undead"; }
        }
        Group {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Group {
            LayoutMode: LeftWrap;
            @CardOn { @Img = "Img/P_Trork.png"; @Name = "Trork"; @Role = "Brute"; @H = 120; @S = 50; @M = 65; }
            @Card { @Img = "Img/P_Feran.png"; @Name = "Feran"; @Role = "Wanderer"; @H = 85; @S = 85; @M = 75; }
            @Card { @Img = "Img/P_Kweebec.png"; @Name = "Kweebec"; @Role = "Druid"; @H = 55; @S = 105; @M = 95; }
            @Card { @Img = "Img/P_Goblin.png"; @Name = "Goblin"; @Role = "Scavenger"; @H = 60; @S = 95; @M = 65; }
            @Card { @Img = "Img/P_Outlander.png"; @Name = "Outlander"; @Role = "Mystic"; @H = 70; @S = 70; @M = 85; }
            @Card { @Img = "Img/P_Undead.png"; @Name = "Undead"; @Role = "Revenant"; @H = 75; @S = 65; @M = 70; }
            @Card { @Img = "Img/P_FenStalker.png"; @Name = "Fen Stalker"; @Role = "Hunter"; @H = 80; @S = 80; @M = 55; }
            @Card { @Img = "Img/P_GolemEarth.png"; @Name = "Earth Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
            @Card { @Img = "Img/P_GolemFlame.png"; @Name = "Flame Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
            @Card { @Img = "Img/P_GolemFrost.png"; @Name = "Frost Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
            @Card { @Img = "Img/P_GolemThunder.png"; @Name = "Thunder Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
            @Card { @Img = "Img/P_GolemSand.png"; @Name = "Sand Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
            @Card { @Img = "Img/P_GolemFiresteel.png"; @Name = "Firesteel Golem"; @Role = "Construct"; @H = 130; @S = 45; @M = 65; }
          }
        }
      }

      $C.@VerticalSeparator { Anchor: (Width: 6, Horizontal: 14); }

      // ---- Hero art ----
      Group {
        Anchor: (Width: 420);
        LayoutMode: Top;
        Group {
          Anchor: (Height: 520);
          Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 4);
          Group { Anchor: (Width: 400, Height: 441, Bottom: 20); Background: "Img/Hero_Trork.png"; }
        }
        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Top: 12);
          $K.@IconBtn { @Icon = "Img/ArrowL.png"; }
          Group {
            FlexWeight: 1;
            LayoutMode: Middle;
            Label { Text: "Chieftain"; Style: (FontSize: 18, RenderBold: true, TextColor: #f1e3c4, HorizontalAlignment: Center); }
            Label { Text: "VARIANT 3 OF 8"; Style: (FontSize: 11, RenderBold: true, TextColor: #5f6f82, HorizontalAlignment: Center); }
          }
          $K.@IconBtn { @Icon = "Img/ArrowR.png"; }
        }
      }

      $C.@VerticalSeparator { Anchor: (Width: 6, Horizontal: 14); }

      // ---- Character sheet ----
      Group {
        FlexWeight: 1;
        LayoutMode: Top;

        Label { Text: "Trork"; Style: (FontName: "Secondary", FontSize: 40, RenderBold: true, RenderUppercase: true, TextColor: #f1e3c4); }
        Label { Text: "Brute of the Highlands"; Style: (FontSize: 15, RenderBold: true, TextColor: #b08d4a); }
        Label {
          Anchor: (Top: 10);
          Text: "A large, brutish warrior. Much higher health and physical resistance.";
          Style: (FontSize: 15, TextColor: #b9c6d3, Wrap: true);
        }

        $K.@Section { @Text = "Attributes"; }
        $K.@Stat { @Icon = "Img/S_Health.png"; @Name = "Health"; @Val = "140"; @ValColor = #7fd36b; @Fill = 170; @BarColor = #c94b4b; }
        $K.@Stat { @Icon = "Img/S_Stamina.png"; @Name = "Stamina"; @Val = "95"; @ValColor = #e36b5b; @Fill = 80; @BarColor = #d9a63a; }
        $K.@Stat { @Icon = "Img/S_Mana.png"; @Name = "Mana"; @Val = "100"; @ValColor = #96a9be; @Fill = 100; @BarColor = #4f7fd9; }

        $K.@Section { @Text = "Resistances"; }
        Group {
          LayoutMode: LeftWrap;
          $K.@Resist { @Icon = "Img/S_Physical.png"; @Text = "Physical -25%"; }
        }

        $K.@Section { @Text = "Abilities"; }
        $K.@Ability { @Icon = "Img/A_Rune_Enrage.png"; @Name = "Berserker Fury"; @Tag = "Passive"; @Desc = "Deal 20% more damage when below 50% health."; }

        $K.@Section { @Text = "Starter Kit"; }
        Group {
          LayoutMode: Left;
          $K.@Item { @Img = "Img/I_Armor_Trork_Warrior_Head.png"; }
          $K.@Item { @Img = "Img/I_Armor_Trork_Warrior_Chest.png"; }
          $K.@Item { @Img = "Img/I_Armor_Trork_Warrior_Hands.png"; }
          $K.@Item { @Img = "Img/I_Armor_Trork_Warrior_Legs.png"; }
          $K.@Item { @Img = "Img/I_Weapon_Sword_Stone_Trork.png"; }
        }

        $K.@Section { @Text = "Details"; }
        @Fact { @K = "Size"; @V = "Large (1.9 blocks)"; }
        @Fact { @K = "Variants"; @V = "8 skins"; }
        @Fact { @K = "Cosmetics"; @V = "174 pieces in 10 slots"; }
      }
    }
  }

  Group {
    LayoutMode: Right;
    Anchor: (Right: 70, Bottom: 50, Height: 44, Left: 70);
    $C.@TextButton #Next { @Text = "NEXT: APPEARANCE"; @Anchor = (Width: 280); }
    Group { Anchor: (Width: 10); }
    $C.@CancelTextButton #Cancel { @Text = "CANCEL"; @Anchor = (Width: 180); }
  }
}
